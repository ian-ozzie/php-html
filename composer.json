{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "ian-ozzie/html",
  "type": "library",
  "description": "Object based HTML generator",
  "license": "MIT",
  "authors": [
    {
      "name": "Ian Oswald",
      "email": "ian@ozzie.io"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "ian-ozzie/pint-config": "^2.0",
    "illuminate/contracts": "*",
    "illuminate/view": "^13.12",
    "livewire/livewire": "^4.3",
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^4.6",
    "phpstan/phpstan": "^2.1",
    "tomasvotruba/type-coverage": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "Ozzie\\Html\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ozzie\\Html\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": [
      "@lint:style",
      "@lint:stan"
    ],
    "lint:fix": [
      "pint --parallel"
    ],
    "lint:stan": [
      "phpstan analyse --memory-limit=2G"
    ],
    "lint:style": [
      "pint --parallel --test"
    ],
    "test": [
      "pest --display-errors --display-warnings --display-notices"
    ],
    "test:coverage": [
      "pest --coverage --min=100"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
